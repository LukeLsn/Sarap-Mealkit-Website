<main class="container py-5 flex-grow-1 d-flex align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="form-card mx-auto">
                <h2>Welcome back</h2>
                
                <form action="/log-in" method="POST">
                    <div class="input-group mb-3">
                        <input type="email" class="form-control" name="email" placeholder="Email address">
                    </div>
                    
                    <div class="input-group mb-3">
                        <input type="password" class="form-control" name="password" placeholder="Password">
                    </div>

                    <div class="radio-group mb-4 d-flex justify-content-center gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="role" id="customer" value="customer" checked>
                            <label class="form-check-label" for="customer">Customer</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="role" id="clerk" value="clerk">
                            <label class="form-check-label" for="clerk">Data Clerk</label>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-submit w-100">Log in</button>
                </form>
            </div>
        </div>
    </div>
</main>