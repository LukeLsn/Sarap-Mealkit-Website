<main class="container py-5 flex-grow-1 d-flex align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="form-card mx-auto">
                <h2>Welcome back</h2>
                
                <form action="/log-in" method="POST">
                    <div class="mb-3">
                        <input type="email" class="form-control" name="email" placeholder="Email address" id="email"  value="<%= values ? values.email : '' %>">
                        <% if (errors && errors.email) { %>
                        <p class="error-msg" style="color: red;"><%= errors.email %></p>
                        <% } %>
                    </div>
                    
                    <div class="mb-3">
                        <input type="password" class="form-control" name="password" placeholder="Password" id="password"  value="<%= values ? values.password : '' %>">
                        <% if (errors && errors.password) { %>
                        <p class="error-msg" style="color: red;"><%= errors.password %></p>
                        <% } %>
                    </div>

                    <div class="radio-group mb-4 d-flex justify-content-center gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="role" id="customer" value="customer"
                            <%= (values.role === 'customer' || !values.role) ? 'checked' : '' %>>
                            <label class="form-check-label" for="customer">Customer</label>
                        </div>
                            <div class="form-check">
                            <input class="form-check-input" type="radio" name="role" id="clerk" value="clerk"
                            <%= values.role === 'clerk' ? 'checked' : '' %>>
                            <label class="form-check-label" for="clerk">Data Clerk</label>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-submit w-100">Log in</button>
                </form>
            </div>
        </div>
    </div>
</main>