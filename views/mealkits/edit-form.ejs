<section class="container my-5">
    <h2 class="text-center mb-4">Edit Meal Kit: <%= kit.title %></h2>

    <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/mealkits/edit/<%= kit._id %>" method="POST" enctype="multipart/form-data" class="border p-4 shadow-sm">
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Meal Kit Title</label>
                <input type="text" name="title" class="form-control" value="<%= kit.title %>" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Category (e.g., Classic, Filipino)</label>
                <input type="text" name="category" class="form-control" value="<%= kit.category %>" required>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Includes (Ingredients)</label>
            <input type="text" name="includes" class="form-control" value="<%= kit.includes %>">
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= kit.description %></textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Price ($)</label>
                <input type="number" step="0.01" name="price" class="form-control" value="<%= kit.price %>" required>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Cooking Time (min)</label>
                <input type="number" name="cookingTime" class="form-control" value="<%= kit.cookingTime %>">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Servings</label>
                <input type="number" name="servings" class="form-control" value="<%= kit.servings %>">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Current Image</label>
            <div class="mb-2">
                <img src="<%= kit.imageUrl %>" alt="<%= kit.title %>" style="height: 100px; border-radius: 5px; border: 1px solid #ddd;">
            </div>
            <label class="form-label">Change Image (.jpg, .png, .gif) - <small class="text-muted">Leave blank to keep current</small></label>
            <input type="file" name="imageUrl" class="form-control">
        </div>

        <div class="mb-4 form-check">
            <input type="checkbox" name="featuredMealKit" class="form-check-input" id="featured" <%= kit.featuredMealKit ? 'checked' : '' %>>
            <label class="form-check-label" for="featured">Show as Featured on Home Page</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Update Meal Kit</button>
        <a href="/mealkits/list" class="btn btn-link d-block text-center mt-2">Cancel and Go Back</a>
    </form>
</section>