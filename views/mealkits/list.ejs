<main class="container py-5" style="min-height: 70vh;">
    <div class="row mb-4">
        <div class="col">
            <h2>Manage Meal Kits</h2>
        </div>
        <div class="col text-end">
            <a href="/mealkits/add" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Add New Meal Kit
            </a>
        </div>
    </div>

    <% if (user && role === 'clerk') { %>
        <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-4">
            <span>Need to populate the initial menu data?</span>
            <a href="/load-data/mealkits" class="btn btn-sm btn-info">Load Default Meal Kits</a>
        </div>
    <% } %>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (mealkits && mealkits.length > 0) { %>
                    <% mealkits.forEach(kit => { %>
                        <tr>
                            <td>
                                <img src="<%= kit.imageUrl %>" alt="<%= kit.title %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                            </td>
                            <td><strong><%= kit.title %></strong></td>
                            <td><span class="badge bg-light text-dark border"><%= kit.category %></span></td>
                            <td>$<%= kit.price.toFixed(2) %></td>
                            <td class="text-center">
                                <a href="/mealkits/edit/<%= kit._id %>" class="btn btn-sm btn-outline-primary me-2">
                                    Edit
                                </a>
                                <a href="/mealkits/remove/<%= kit._id %>" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            No meal kits found. Click "Add" or "Load Default" to get started!
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>