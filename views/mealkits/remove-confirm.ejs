<section class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center border p-5 shadow-sm">
            <h2 class="text-danger mb-4">Delete Confirmation</h2>
            
            <p class="lead">Are you sure you want to delete the following meal kit?</p>
            
            <div class="card mb-4">
                <img src="<%= kit.imageUrl %>" class="card-img-top mx-auto mt-3" alt="<%= kit.title %>" style="width: 200px;">
                <div class="card-body">
                    <h5 class="card-title"><%= kit.title %></h5>
                    <p class="card-text text-muted"><%= kit.category %></p>
                </div>
            </div>

            <form action="/mealkits/remove/<%= kit._id %>" method="POST">
                <button type="submit" class="btn btn-danger px-4">Yes, Delete It</button>
                <a href="/mealkits/list" class="btn btn-secondary px-4">No, Go Back</a>
            </form>
        </div>
    </div>
</section>